# Postgres connection string (Vercel Postgres, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Password required to view the dashboard (owner-only, single password gate)
APP_PASSWORD="change-me"

# Secret the assistant must send as a Bearer token to POST /api/import
IMPORT_SECRET="change-me-too"

# Random long string used to sign the session cookie
SESSION_SECRET="a-long-random-string-used-to-sign-the-session-cookie"
