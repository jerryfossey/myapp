generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton row (id always 1). Fully assistant-owned: overwritten wholesale on import.
model Meta {
  id    Int      @id @default(1)
  owner String
  today DateTime @db.Date
}

// Singleton row (id always 1). Fully assistant-owned: overwritten wholesale on import.
model Bhag {
  id           Int      @id @default(1)
  label        String
  cashOnHand   Float
  cashTarget   Float
  helocBalance Float
  asOf         DateTime @db.Date
  note         String?  @db.Text
}

model Area {
  id          String     @id
  name        String
  // --- assistant-owned (overwritten on every import) ---
  state       String     @db.Text
  metricLabel String
  metricValue String
  constraint  String     @db.Text
  lever       String     @db.Text
  // ----------------------------------------------------
  archived    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reports     Report[]
  followUps   FollowUp[]
  projects    Project[]
}

// Owner-authored grouping for follow-ups (app UI only, like ad-hoc
// follow-ups/reports — not part of the import payload). A project's
// "subtasks" are just FollowUp rows with this as their projectId, so they
// keep every existing follow-up behavior (status, scheduling, recurrence,
// delegation) unchanged; progress is computed from their statuses, never
// stored.
model Project {
  id        String     @id @default(cuid())
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id])
  name      String
  dueDate   DateTime?  @db.Date
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  followUps FollowUp[]

  @@index([areaId, archived])
}

model Report {
  id     String @id
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  // --- assistant-owned (overwritten on every import) ---
  person  String
  owes    String @db.Text
  cadence String
  // ----------------------------------------------------

  // --- owner-owned (app UI only; never touched by import except on create) ---
  status        String    @default("due") // "in" | "due" | "overdue" | "done"
  lastReceivedAt DateTime?
  // ----------------------------------------------------------------------------

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id     String @id
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  // --- assistant-owned (overwritten on every import) ---
  item       String @db.Text
  waitingOn  String
  nextAction String @db.Text
  // ----------------------------------------------------

  // --- owner-owned (app UI only; never touched by import on update) ---
  status        String    @default("open") // "open" | "done" | "delegated"
  priority      Int?
  lastTouched   DateTime  @db.Date // set by import ONLY on create
  scheduledFor  DateTime? @db.Date // which day this is planned for; null = unscheduled/backlog
  dueDate       DateTime? @db.Date // deadline, independent of scheduledFor

  // Optional project grouping — a "subtask" is just a FollowUp with this set.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Recurrence, app UI only. recurrenceType null = one-off (the default).
  // "fixed": next occurrence steps forward from recurrenceStart on a fixed
  // calendar cadence (e.g. the 1st of every month), independent of when it
  // was actually completed. "afterComplete": next occurrence is
  // recurrenceInterval/recurrenceUnit after the day it's marked done.
  // Marking a recurring item done spawns the next occurrence as a new row
  // carrying the same recurrence config forward; this row's own fields are
  // left as a historical record.
  recurrenceType     String?
  recurrenceInterval Int?
  recurrenceUnit     String? // "days" | "weeks" | "months"
  recurrenceStart    DateTime? @db.Date
  // ----------------------------------------------------------------------

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]

  @@index([status, priority, lastTouched])
  @@index([status, scheduledFor])
  @@index([projectId])
}

model Note {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  text       String   @db.Text
}

// Append-only log: one row per follow-up status change. Never deleted or
// updated. Powers the Dashboard's completions-per-week trend.
model StatusEvent {
  id         String   @id @default(cuid())
  followUpId String
  areaId     String
  from       String
  to         String
  at         DateTime @default(now())

  @@index([areaId, at])
  @@index([to, at])
}

// Append-only log: one row per import that includes a bhag block. Never
// deleted or updated. Powers the Dashboard's BHAG progress trend.
model Snapshot {
  id           String   @id @default(cuid())
  kind         String // "bhag"
  cashOnHand   Float
  helocBalance Float
  cashTarget   Float
  asOf         DateTime @db.Date
  at           DateTime @default(now())

  @@index([kind, at])
}

// Weekly planned vs. actual hours per time category. Upserted by
// (week, categoryId): planned is seeded/editable in-app, actual is pushed
// via the import "time" block.
model TimeWeek {
  week       String // ISO week, e.g. "2026-W35"
  categoryId String
  planned    Float
  actual     Float?

  @@id([week, categoryId])
}

// One row per calendar day a "time" import block was received for a given
// ISO week — powers the "days uploaded: N/7" completeness note. Not part
// of the brief's three named models; a minimal additive log needed because
// time_weeks stores only a weekly total, not per-day data.
model TimeUploadLog {
  week String // ISO week, e.g. "2026-W35"
  date String // YYYY-MM-DD, the calendar day the import was received
  at   DateTime @default(now())

  @@id([week, date])
}
